# Индивидуальные настройки брокера kafka-1
KAFKA_BROKER_ID=1

KAFKA_LISTENERS=INTERNAL_SSL://0.0.0.0:19093,EXTERNAL_SSL://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL_SSL://kafka-1:19093,EXTERNAL_SSL://localhost:9093

# Файлы в /etc/kafka/secrets (смонтирован certs/kafka-1)
KAFKA_SSL_KEYSTORE_FILENAME=kafka-1.keystore.p12
KAFKA_SSL_KEYSTORE_CREDENTIALS=kafka-1_keystore_creds
KAFKA_SSL_KEY_CREDENTIALS=kafka-1_sslkey_creds
KAFKA_SSL_TRUSTSTORE_FILENAME=kafka-1.truststore.p12
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=kafka-1_truststore_creds

