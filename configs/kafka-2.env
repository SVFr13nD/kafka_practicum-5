# Индивидуальные настройки брокера kafka-2
KAFKA_BROKER_ID=2

KAFKA_LISTENERS=INTERNAL_SSL://0.0.0.0:19093,EXTERNAL_SSL://0.0.0.0:9094
KAFKA_ADVERTISED_LISTENERS=INTERNAL_SSL://kafka-2:19093,EXTERNAL_SSL://localhost:9094

# Файлы в /etc/kafka/secrets (смонтирован certs/kafka-2)
KAFKA_SSL_KEYSTORE_FILENAME=kafka-2.keystore.p12
KAFKA_SSL_KEYSTORE_CREDENTIALS=kafka-2_keystore_creds
KAFKA_SSL_KEY_CREDENTIALS=kafka-2_sslkey_creds
KAFKA_SSL_TRUSTSTORE_FILENAME=kafka-2.truststore.p12
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=kafka-2_truststore_creds

