# Общие настройки SSL и ACL для всех брокеров (confluentinc/cp-kafka: KAFKA_X_Y -> x.y в server.properties)

KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# --- Listeners: оба по SSL ---
# INTERNAL_SSL - межброкерный трафик и клиенты внутри docker-сети
# EXTERNAL_SSL - клиенты с хоста (localhost:9093/9094/9095)
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL_SSL:SSL,EXTERNAL_SSL:SSL
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL_SSL

# --- SSL ---
KAFKA_SSL_KEYSTORE_TYPE=PKCS12
KAFKA_SSL_TRUSTSTORE_TYPE=PKCS12
# Взаимная аутентификация: клиент обязан предъявить сертификат, подписанный нашим CA
KAFKA_SSL_CLIENT_AUTH=required
# Проверка имени хоста включена (SAN сертификатов: kafka-N, localhost)
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https

# --- ACL ---
KAFKA_AUTHORIZER_CLASS_NAME=kafka.security.authorizer.AclAuthorizer
KAFKA_ALLOW_EVERYONE_IF_NO_ACL_FOUND=false
# Принципал при SSL = Subject сертификата, у наших сертификатов он вида CN=<имя>
KAFKA_SUPER_USERS=User:CN=kafka-1;User:CN=kafka-2;User:CN=kafka-3;User:CN=admin

# --- Репликация служебных топиков ---
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

