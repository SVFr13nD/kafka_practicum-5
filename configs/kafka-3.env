# Индивидуальные настройки брокера kafka-3
KAFKA_BROKER_ID=3

KAFKA_LISTENERS=INTERNAL_SSL://0.0.0.0:19093,EXTERNAL_SSL://0.0.0.0:9095
KAFKA_ADVERTISED_LISTENERS=INTERNAL_SSL://kafka-3:19093,EXTERNAL_SSL://localhost:9095

# Файлы в /etc/kafka/secrets (смонтирован certs/kafka-3)
KAFKA_SSL_KEYSTORE_FILENAME=kafka-3.keystore.p12
KAFKA_SSL_KEYSTORE_CREDENTIALS=kafka-3_keystore_creds
KAFKA_SSL_KEY_CREDENTIALS=kafka-3_sslkey_creds
KAFKA_SSL_TRUSTSTORE_FILENAME=kafka-3.truststore.p12
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=kafka-3_truststore_creds

